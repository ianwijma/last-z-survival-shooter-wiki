# Required: OpenRouter API key for pipeline LLM calls (extraction, writing, curator)
OPENROUTER_API_KEY=

# Required: YouTube Data API key for video metadata (title, author, publishedAt)
# Transcripts are fetched via yt-dlp without auth
YOUTUBE_API_KEY=

# Optional: Reddit user-agent string (required by Reddit public API ToS)
REDDIT_USER_AGENT=last-z-wiki-pipeline/1.0

# Optional: Override model tiers (defaults listed below)
# MODEL_EXTRACT=anthropic/claude-sonnet-4
# MODEL_FORMAT=google/gemini-2.5-flash
# MODEL_VISION=google/gemini-2.5-pro
# MODEL_FALLBACK=anthropic/claude-haiku-4

# Optional: Base path for deployment (empty for root domain, e.g. /last-z-wiki for GitHub Pages)
WIKI_BASE_PATH=
